# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ─── Base de datos ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://paintonline:paintonline@localhost:5432/paintonline?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (cambiar en produccion) ─────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-jwt_access_secret"
JWT_REFRESH_SECRET="change-me-jwt_refresh_secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# ─── Parametros de dibujo ──────────────────────────────────────────────────
# Ventana de flush del buffer de trazos (ms)
STROKE_FLUSH_MS=40
# TTL del lock de capa en modo FREE (ms)
LAYER_LOCK_TTL_MS=5000
# TTL de presencia sin heartbeat (ms)
PRESENCE_TTL_MS=30000
# Puntos maximos por evento stroke_points
MAX_POINTS_PER_EVENT=64
# Puntos maximos por trazo
MAX_POINTS_PER_STROKE=20000
# Si false, en modo FREE un trazo sobre capa bloqueada se rechaza
LAYER_LOCK_STRICT=false
